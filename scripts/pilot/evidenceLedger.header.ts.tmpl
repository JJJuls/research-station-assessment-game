export type LedgerItemId =
__ITEM_IDS__;

export type LedgerDispositionClass =
  | 'strong'
  | 'conditional'
  | 'questionnaire_primary';

export type LedgerEpisode = 1 | 2 | 3 | 4 | 5 | 6;

export interface LedgerWindow {
  /** Provisional window/version id (item-owned). */
  id: string;
  episode: LedgerEpisode;
  /** Occasion tag for repeated-occasion items; null otherwise. */
  occasion: string | null;
}

export interface LedgerRoute {
  location: string;
  mechanic: string;
  episodes: LedgerEpisode[];
  /** Provisional SA-13 opportunity ids (empty for questionnaire-primary items). */
  opportunity_ids: string[];
  windows: LedgerWindow[];
  /** Primary event-family prefixes; pairwise disjoint across items. */
  family_prefixes: string[];
  /** Secondary contextual telemetry ids (never primary evidence). */
  secondary_telemetry_ids: string[];
  implementation_status: 'planned' | 'implemented' | 'partial';
}

export interface EvidenceLedgerEntry {
  id: LedgerItemId;
  instrument: string;
  facet_or_scale: string;
  /** Verbatim sheet 09 disposition. */
  final_disposition: string;
  disposition_class: LedgerDispositionClass;
  analysis_level: string;
  final_game_opportunity: string;
  /** Raw components only — never a score. */
  candidate_raw_variables: string[];
  validity_gate: string;
  rival_explanations: string;
  active_seconds: number;
  implementation_action: string;
  episode_label: string;
  primary_source: string;
  route: LedgerRoute;
}

export const LEDGER_WORKBOOK_MD5 = __MD5__;
export const LEDGER_SHEET = __SHEET__;

export const LEDGER_EPISODES: Record<LedgerEpisode, string> = {
__EPISODES__
};

export const LEDGER_INFERENCE_MODEL: readonly {
  instrument: string;
  facet_or_scale: string;
  items: LedgerItemId[];
}[] = __INFERENCE__;

export const LEDGER_BURDEN_BUDGET = {
  item_owned_active_seconds: 1040,
  shared_overhead_seconds: 420,
  non_scored_closure_seconds: 75,
  planned_total_seconds: 1535,
  human_median_target_minutes: 27,
  human_p90_gate_minutes: 30,
  status: 'Planning estimate only — requires human pilot',
} as const;

export const EVIDENCE_LEDGER: readonly EvidenceLedgerEntry[] = [
__ITEMS__,
];

export function ledgerEntry(id: LedgerItemId): EvidenceLedgerEntry {
  const entry = EVIDENCE_LEDGER.find((candidate) => candidate.id === id);

  if (entry === undefined) {
    throw new Error(`Unknown ledger item: ${id}`);
  }

  return entry;
}

export function ledgerClassificationCounts(): Record<
  LedgerDispositionClass,
  number
> {
  const counts: Record<LedgerDispositionClass, number> = {
    strong: 0,
    conditional: 0,
    questionnaire_primary: 0,
  };

  for (const entry of EVIDENCE_LEDGER) {
    counts[entry.disposition_class] += 1;
  }

  return counts;
}

/** Every primary family prefix across the ledger (pairwise-disjointness tests). */
export function ledgerFamilyPrefixes(): readonly string[] {
  return EVIDENCE_LEDGER.flatMap((entry) => entry.route.family_prefixes);
}

/** Every provisional opportunity id across the ledger. */
export function ledgerOpportunityIds(): readonly string[] {
  return EVIDENCE_LEDGER.flatMap((entry) => entry.route.opportunity_ids);
}

/** Ledger entries hosting a window in the given episode. */
export function ledgerItemsInEpisode(
  episode: LedgerEpisode,
): readonly EvidenceLedgerEntry[] {
  return EVIDENCE_LEDGER.filter((entry) =>
    entry.route.windows.some((window) => window.episode === episode),
  );
}
