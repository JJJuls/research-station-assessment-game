{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git branch --list:*)",
      "Bash(git worktree list:*)",
      "Bash(git tag --list:*)",
      "Bash(npm.cmd run lint:tsc)",
      "Bash(npm.cmd run lint)",
      "Bash(npm.cmd run build)",
      "Bash(node --test scripts/claude/:*)",
      "Bash(node scripts/claude/verify-unit.mjs:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git add .)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add -u:*)",
      "Bash(git commit -a:*)",
      "Bash(git commit -am:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git filter-branch:*)",
      "Bash(git config:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm publish:*)",
      "Bash(npm audit fix:*)",
      "Bash(npm uninstall:*)",
      "Bash(pnpm add:*)",
      "Bash(yarn add:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "Bash(gh repo delete:*)",
      "Bash(vercel:*)",
      "Bash(netlify:*)",
      "Bash(wrangler:*)",
      "Bash(docker push:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Edit(docs/scientific/**)",
      "Write(docs/scientific/**)",
      "Edit(docs/research/**)",
      "Write(docs/research/**)",
      "Edit(docs/decisions/**)",
      "Write(docs/decisions/**)",
      "Edit(04_GLOBAL_SCIENTIFIC_RULING_VERBATIM.txt)",
      "Write(04_GLOBAL_SCIENTIFIC_RULING_VERBATIM.txt)",
      "Edit(docs/ai/SCIENTIFIC-AUTHORITY-AND-OPEN-DECISIONS.md)",
      "Write(docs/ai/SCIENTIFIC-AUTHORITY-AND-OPEN-DECISIONS.md)",
      "Edit(docs/ai/fable-claude-final-game-build-contract-v3.txt)",
      "Write(docs/ai/fable-claude-final-game-build-contract-v3.txt)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(package-lock.json)",
      "Write(package-lock.json)",
      "Edit(tsconfig.json)",
      "Write(tsconfig.json)",
      "Edit(playwright.config.ts)",
      "Write(playwright.config.ts)",
      "Edit(vite.config.mts)",
      "Write(vite.config.mts)",
      "Edit(eslint.config.mts)",
      "Write(eslint.config.mts)",
      "Edit(.commitlintrc.json)",
      "Write(.commitlintrc.json)",
      "Edit(.husky/**)",
      "Write(.husky/**)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.example)",
      "Write(.env.example)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(asset-candidates/**)",
      "Write(asset-candidates/**)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude/pretool-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
