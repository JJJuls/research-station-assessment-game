# Research-session ingestion (Supabase Edge Function).
#
# NEVER put real values in this file or in the tracked `.env` — copy the
# lines below into an untracked `.env.local` (gitignored) and fill them in
# there. Pilot V3 (PROVISIONAL INT-2/INT-5): a participant bundle built with
# these values exports each completed session (and a keep-alive `incomplete`
# envelope on early exit); a bundle built WITHOUT them exports nothing and
# reports export_status=not_applicable. In a DEV build only
# `launch_mode=test` sessions export. See docs/operations/QUALTRICS-HANDOFF.md.
#
# VITE_RESEARCH_INGEST_URL: full URL of the development Edge Function,
#   https://<project-ref>.supabase.co/functions/v1/ingest-research-session
# VITE_SUPABASE_PUBLISHABLE_KEY: the Supabase publishable (client) API key
#   for the same development project. Publishable — but still keep it out
#   of tracked files.
VITE_RESEARCH_INGEST_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Pilot V3 (PROVISIONAL INT-4): hosts the completion handoff may navigate to
# (https only; a host matches itself or any subdomain). Comma-separated.
# Unset = qualtrics.com. DEV builds also accept http://localhost for tests.
VITE_RETURN_URL_ALLOWED_HOSTS=
